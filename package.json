{
  "name": "qualeobairro",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "preview": "vite preview",
    "build:geo": "node scripts/build-geo.mjs",
    "build:exclude": "node scripts/build-exclude.mjs",
    "build:matrix": "node scripts/build-matrix.mjs",
    "gen:hints": "node scripts/gen-hints.mjs",
    "test:hints-response": "node --test scripts/hints-response.selfcheck.mjs",
    "check:hints": "node scripts/check-hints.mjs",
    "build:shared": "node scripts/build-shared.mjs",
    "build:data": "npm run build:geo && npm run build:exclude && npm run build:matrix && npm run build:shared && npm run check:hints"
  },
  "dependencies": {
    "d3-geo": "^3.1.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/d3-geo": "^3.1.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.1",
    "@turf/turf": "^7.2.0",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "mapshaper": "^0.6.113",
    "prettier": "^3.6.2",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.40.0",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}

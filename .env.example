# Browser variables. Vite inlines every VITE_ variable into the client bundle.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server and tooling only.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=

# Never give SUPABASE_SERVICE_ROLE_KEY or SUPABASE_DB_PASSWORD a VITE_ prefix.
# Comma-separated production origins accepted by the Edge Functions.
ALLOWED_ORIGINS=https://qualeobairro.com.br

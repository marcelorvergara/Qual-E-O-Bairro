# Browser variables. Vite inlines every VITE_ variable into the client bundle.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_ENABLE_EN=false
VITE_GA_MEASUREMENT_ID=G-SCTEKMN7V2

# Server and tooling only.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=
EXPLAINER_ENABLED=false

# Never give SUPABASE_SERVICE_ROLE_KEY or SUPABASE_DB_PASSWORD a VITE_ prefix.
# Comma-separated development and production origins accepted by Edge Functions.
ALLOWED_ORIGINS=http://localhost:5173,https://qualeobairro.com.br
# Explainer generation is off unless EXPLAINER_ENABLED is exactly "true".
